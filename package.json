{
  "name": "auto-live2d-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/controller.test.ts tests/speech-motion.test.ts tests/performance.test.ts tests/semantic-performance.test.ts tests/runtime-takeover.test.ts tests/performance-default.test.ts tests/continuous-performance.test.ts tests/emotion-curve.test.ts",
    "test:browser": "tsx tests/release-smoke.ts",
    "test:continuous": "tsx tests/continuous-speech-browser.ts"
  },
  "dependencies": {
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "playwright": "1.64.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
