{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playback-time action event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "clause",
    "action",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "performance.plan.v4"
    },
    "clause": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "variant",
        "strength",
        "hold_ms",
        "onset_fraction"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "variant": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hold_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 6000
        },
        "onset_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.95
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
