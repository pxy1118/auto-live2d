{
  "schema_version": "live2d.tools.v6.3",
  "transport": "POST /api/command or command message on /ws",
  "envelope": {
    "method": "method from tools",
    "params": "parameters",
    "request_id": "unique id, reuse exactly on retry"
  },
  "tools": [
    {
      "method": "performance.start",
      "description": "开始持续表演会话；返回 session_id。需启用浏览器声音。",
      "parameters": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string",
            "maxLength": 800
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "motion_style": {
            "enum": [
              "restrained",
              "natural",
              "lively"
            ],
            "default": "lively"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "method": "performance.append",
      "description": "追加增量文字；完整句、长度上限或明确 flush 时形成语音单元，逗号不提交。seq 必须严格递增。",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "flush": {
            "type": "boolean"
          }
        },
        "required": [
          "session_id",
          "seq",
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "method": "performance.finish",
      "description": "结束文本输入并提交剩余文字；不取消已排队的语音。",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "session_id",
          "seq"
        ],
        "additionalProperties": false
      }
    },
    {
      "method": "performance.cancel",
      "description": "取消会话与音频；外观保留。",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        },
        "required": [
          "session_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "method": "performance.direct",
      "description": "临时试演情绪或表情。emotion 默认附带角色身体表现；显式 action_id 优先，none 可只看表情。wink 每条指令只执行一次。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string"
          },
          "cue_id": {
            "type": "string"
          },
          "emotion": {
            "enum": [
              "admiration",
              "amusement",
              "anger",
              "annoyance",
              "approval",
              "caring",
              "confusion",
              "curiosity",
              "desire",
              "disappointment",
              "disapproval",
              "disgust",
              "embarrassment",
              "excitement",
              "fear",
              "gratitude",
              "grief",
              "joy",
              "love",
              "nervousness",
              "optimism",
              "pride",
              "realization",
              "relief",
              "remorse",
              "sadness",
              "surprise",
              "neutral"
            ]
          },
          "expression": {
            "enum": [
              "normal",
              "黑脸",
              "流泪",
              "圈圈眼",
              "爱心眼",
              "＞＜",
              "屑屑眼",
              "脸红",
              "加载",
              "兔牙",
              "流冷汗",
              "squint",
              "wink_left",
              "wink_right"
            ]
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "hold_ms": {
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "clause": {
            "type": "integer",
            "minimum": 0
          },
          "action_id": {
            "type": "string",
            "description": "registered action ID; capabilities.get returns current catalog; none releases"
          },
          "variant": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "action_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "action_hold_ms": {
            "type": "number",
            "minimum": 0,
            "maximum": 6000
          }
        }
      }
    },
    {
      "method": "performance.release",
      "description": "释放指定导演指令；省略 cue_id 释放全部。",
      "parameters": {
        "type": "object",
        "properties": {
          "cue_id": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "method": "appearance.update",
      "description": "只修改显式提供的持久外观字段。",
      "parameters": {
        "type": "object",
        "properties": {
          "glasses": {
            "enum": [
              "none",
              "black",
              "monocle"
            ]
          },
          "skirt": {
            "enum": [
              "long",
              "short"
            ]
          },
          "body": {
            "enum": [
              "default",
              "preset1",
              "preset2"
            ]
          },
          "shoes": {
            "type": "boolean"
          },
          "tail": {
            "type": "boolean"
          },
          "chest": {
            "enum": [
              "default",
              "alternate"
            ]
          },
          "bowl": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false,
        "minProperties": 1
      }
    },
    {
      "method": "performance.state",
      "description": "读取当前进度、动作历史、情绪与覆盖指令。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "method": "performance.status",
      "description": "读取候选模型和训练来源。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "method": "appearance.get",
      "description": "读取会话内保持的外观。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "method": "capabilities.get",
      "description": "查询全部参数归属、可用动作通道与外观选项。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "method": "review.list",
      "description": "列出本地偏好样本和忙碌状态",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "method": "review.get",
      "description": "读取一个样本",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          }
        },
        "required": [
          "case_id"
        ]
      }
    },
    {
      "method": "review.create",
      "description": "生成一份供三个候选复用的音频",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "context": {
            "type": "string",
            "maxLength": 800
          },
          "scenario_id": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "context"
        ]
      }
    },
    {
      "method": "review.play",
      "description": "播放一个候选并记录实际执行",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "candidate": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        },
        "required": [
          "case_id",
          "candidate"
        ]
      }
    },
    {
      "method": "review.stop",
      "description": "停止准备或播放；中断记录不能评分",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "method": "review.rate",
      "description": "提交明确人工偏好，保留旧评分，不自动训练",
      "parameters": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "choice": {
            "enum": [
              "A",
              "B",
              "C",
              "neither",
              "tie"
            ]
          },
          "takes": {
            "type": "object"
          },
          "scores": {
            "type": "object"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "case_id",
          "choice",
          "takes",
          "scores",
          "issues",
          "note"
        ]
      }
    }
  ]
}
