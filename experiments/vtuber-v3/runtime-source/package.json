    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "playwright": "1.64.1",
    "typescript": "5.8.3"
  },
  "engines": { "node": ">=22.12.0" }
}
